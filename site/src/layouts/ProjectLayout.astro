---
import type { ImageMetadata, MarkdownHeading } from 'astro';
import type { GallerySlide } from '@/lib/gallery';
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import ProjectHero from '@/components/projects/ProjectHero.astro';
import TableOfContents from '@/components/patterns/TableOfContents.astro';
import CtaBand from '@/components/patterns/CtaBand.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import siteConfig from '@/config/site.config';
import { landing } from '@/config/landing';
import { getDefaultOgPath, getProjectOgPath, isShareableImage } from '@/lib/og/svg';
import { t, getLocaleFromPath, localizedPath } from '@/i18n';
import { docsChangelogLink, docsLink } from '@/lib/links';

interface Props {
  title: string;
  description: string;
  meta?: string[];
  url?: string;
  repo?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  gallery?: GallerySlide[];
  tags?: string[];
  /** Project id, used to resolve the per-project dynamic OG image. */
  slug?: string;
  headings?: MarkdownHeading[];
  /** Per-project override: hide table of contents on this project */
  toc?: boolean;
}

const {
  title,
  description,
  meta = [],
  url,
  repo,
  image,
  imageAlt,
  gallery = [],
  tags = [],
  slug = '',
  headings = [],
  toc: tocOverride,
} = Astro.props;

const locale = getLocaleFromPath(Astro.url.pathname);

// Raster only — an SVG cover cannot serve as a share image, so a project without
// a screenshot falls back to the card generated at build time.
const ogImage =
  image && isShareableImage(image.src)
    ? image.src
    : slug
      ? getProjectOgPath(slug)
      : getDefaultOgPath();

const ogImageAlt = ogImage === image?.src ? imageAlt || title : title;

const tocConfig = siteConfig.articleFeatures?.toc;
const showToc = !!tocConfig?.enabled && tocOverride !== false;
const tocLayout = tocConfig?.layout ?? 'auto';
const sidebarActive = showToc && (tocLayout === 'sidebar' || tocLayout === 'auto');
const inlineActive = showToc && tocLayout === 'inline';
const sidebarOnLeft = (tocConfig?.sidebarPosition ?? 'right') === 'left';

// One page, so the trail is Home → this project. There is no projects index.
const breadcrumbs = [
  { label: t('common.home', locale), href: localizedPath('/', locale) },
  { label: title },
];
---

<BaseLayout title={title} description={description} image={ogImage} imageAlt={ogImageAlt}>
  <Header
    slot="header"
    position="fixed"
    shape="bar"
    variant="solid"
    size="lg"
    showCta={false}
    showScrollProgress
    maxWidth="7xl"
  />

  <div class="min-h-screen pt-16">
    <ProjectHero
      title={title}
      description={description}
      meta={meta}
      url={url}
      repo={repo}
      image={image}
      imageAlt={imageAlt}
      gallery={gallery}
      tags={tags}
    />

    <slot name="after-hero" />

    <article class="pt-8 pb-[var(--space-section-md)]">
      <div class:list={[
        'mx-auto px-6 max-w-7xl',
        sidebarActive && (sidebarOnLeft
          ? 'xl:grid xl:grid-cols-[15rem_minmax(0,1fr)] xl:gap-10'
          : 'xl:grid xl:grid-cols-[minmax(0,1fr)_15rem] xl:gap-10'),
      ]}>
        {sidebarActive && sidebarOnLeft && (
          <aside class="hidden xl:block" aria-label={t('blog.tableOfContents', locale)}>
            <TableOfContents
              headings={headings}
              maxDepth={tocConfig?.maxDepth ?? 3}
              minHeadings={tocConfig?.minHeadings ?? 3}
              sticky
            />
          </aside>
        )}

        <div class:list={['min-w-0 max-w-4xl w-full mx-auto', sidebarActive && 'xl:mx-0']}>
          <Breadcrumbs items={breadcrumbs} class="mb-8" />

          {sidebarActive && (
            <div class="xl:hidden mb-10">
              <TableOfContents
                headings={headings}
                maxDepth={tocConfig?.maxDepth ?? 3}
                minHeadings={tocConfig?.minHeadings ?? 3}
                collapsible
              />
            </div>
          )}

          {inlineActive && (
            <div class="mb-10 rounded-xl border border-border bg-background-secondary p-5">
              <TableOfContents
                headings={headings}
                maxDepth={tocConfig?.maxDepth ?? 3}
                minHeadings={tocConfig?.minHeadings ?? 3}
              />
            </div>
          )}

          <!--
            Framed reading surface, matching the TOC card. Starts at `sm` so
            a phone held upright keeps the full screen width for the text.
          -->
          <div class="sm:rounded-xl sm:border sm:border-border sm:bg-card sm:p-8 lg:p-10">
            <div class="prose prose-lg max-w-none" data-reveal-content>
              <slot />
            </div>
          </div>

          <footer class="border-border mt-12 border-t pt-8 flex justify-center" data-reveal>
            <Button href={docsLink} variant="brand-outline" size="sm">
              <Icon name="arrow-right" size="sm" />
              {landing.cta.primary}
            </Button>
          </footer>
        </div>

        {sidebarActive && !sidebarOnLeft && (
          <aside class="hidden xl:block" aria-label={t('blog.tableOfContents', locale)}>
            <TableOfContents
              headings={headings}
              maxDepth={tocConfig?.maxDepth ?? 3}
              minHeadings={tocConfig?.minHeadings ?? 3}
              sticky
            />
          </aside>
        )}
      </div>
    </article>

    <!-- Closing CTA -->
    <section class="relative z-10 py-[var(--space-section-md)] bg-background border-t border-border">
      <CtaBand maxWidth="7xl">
        <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">
          {landing.cta.heading}
        </h2>
        <p class="text-lg text-foreground-muted mb-8 text-balance">
          {landing.cta.lead}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button size="lg" href={docsLink}>
            {landing.cta.primary}
            <Icon name="arrow-right" size="sm" />
          </Button>
          <Button size="lg" variant="outline" class="cta-btn-brand" href={docsChangelogLink}>
            {landing.cta.secondary}
            <Icon name="arrow-right" size="sm" />
          </Button>
        </div>
      </CtaBand>
    </section>
  </div>

  <Footer slot="footer" layout="columns" background="secondary" maxWidth="7xl" />
</BaseLayout>
