{
  "name": "astro-rocket",
  "version": "2.7.0",
  "packageManager": "pnpm@10.33.0",
  "description": "Astro Rocket \u2014 A production-ready Astro 7 theme built on Tailwind CSS v4",
  "type": "module",
  "author": "Hans Martens",
  "license": "MIT",
  "keywords": [
    "astro",
    "astro-theme",
    "theme",
    "tailwind",
    "tailwindcss",
    "typescript",
    "blog",
    "starter",
    "boilerplate",
    "seo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hansmartensdev/astro-rocket"
  },
  "homepage": "https://github.com/hansmartensdev/astro-rocket#readme",
  "bugs": {
    "url": "https://github.com/hansmartensdev/astro-rocket/issues"
  },
  "scripts": {
    "sync": "node ../website/scripts/sync-changelog.mjs",
    "dev": "node ../website/scripts/sync-changelog.mjs && astro dev",
    "build": "node ../website/scripts/sync-changelog.mjs && astro build",
    "verify": "node scripts/verify-build.mjs",
    "preview": "astro preview",
    "check": "node ../website/scripts/sync-changelog.mjs && astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm lint && pnpm check && pnpm test:run && pnpm build && pnpm verify",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/mdx": "8.1.6",
    "@astrojs/netlify": "^8.2.14",
    "@astrojs/react": "7.1.9",
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@iconify-json/lucide": "^1.2.157",
    "@iconify-json/simple-icons": "^1.2.103",
    "@iconify/react": "^6.0.4",
    "astro": "7.4.13",
    "astro-icon": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fontkit": "^3.0.0",
    "lucide-react": "^1.77.0",
    "png-to-ico": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.39.0",
    "schema-dts": "^2.1.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
